{
  "name": "__slug__-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "__Name__ for the Mac (Tauri 2), started from krizaka/template-tauri-app.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/init.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm typecheck && pnpm test && pnpm test:rust",
    "tauri": "tauri",
    "build:app": "tauri build --bundles dmg --target aarch64-apple-darwin"
  },
  "dependencies": {
    "@krizaka/app-client": "^0.1.0",
    "@krizaka/app-desktop": "^0.1.0",
    "@krizaka/i18n": "^0.2.1",
    "@krizaka/icons": "^0.7.0",
    "@krizaka/tailwind": "^3.46.0",
    "@krizaka/tokens": "^3.46.0",
    "@krizaka/ui": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-http": "^2.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.6"
}
